<?xml version="1.0" ?>
<theme name="ShopnoOS" format="1.3">
  <color_scheme>Black</color_scheme>
  <background_gradient>50.0</background_gradient>
  <key_style>flat</key_style>
  <roundrect_radius>5.0</roundrect_radius>
  <key_size>100.0</key_size>
  <key_stroke_width>100.0</key_stroke_width>
  <key_fill_gradient>10.0</key_fill_gradient>
  <key_stroke_gradient>32.0</key_stroke_gradient>
  <key_gradient_direction>0.0</key_gradient_direction>
  <key_label_font>Liberation Sans</key_label_font>
  <key_label_overrides/>
  <key_shadow_strength>0.0</key_shadow_strength>
  <key_shadow_size>0.0</key_shadow_size>
</theme>