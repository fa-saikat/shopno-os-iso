#!/usr/bin/env bash

set -e

if [[ -d /usr/src/onboard ]]; then
    bash /usr/src/onboard/build_debs.sh
    bash /usr/src/onboard/apt_install_debs.sh
else
    echo "Onboard src directory not found"
fi

if [[ ! -d /etc/lightdm/lightdm.conf.d ]]; then
	mkdir -p /etc/lightdm/lightdm.conf.d
fi

cat << 'EOF' > /etc/lightdm/lightdm.conf.d/01-autologin.conf
[Seat:*]
autologin-user=kiosk
autologin-session=openbox
EOF

